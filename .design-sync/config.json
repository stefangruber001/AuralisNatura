{
  "pkg": "@auralis/design-system",
  "globalName": "AuralisNatura",
  "shape": "package",
  "buildCmd": "npm run build",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "cssEntry": "dist/auralis.css",
  "tokensGlob": "src/styles/tokens.css",
  "extraFonts": ["assets/fonts.css"],
  "docsDir": "docs",
  "guidelinesGlob": ["docs/guides/**/*.md"],
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Button": { "cardMode": "column" },
    "Display": { "cardMode": "column" },
    "Heading": { "cardMode": "column" },
    "Em": { "cardMode": "column" },
    "Text": { "cardMode": "column" },
    "Label": { "cardMode": "column" },
    "Signature": { "cardMode": "column" },
    "SectionHead": { "cardMode": "column" },
    "CtaCard": { "cardMode": "column" },
    "ImageBand": { "cardMode": "column" },
    "FaqItem": { "cardMode": "column" },
    "FaqList": { "cardMode": "column" },
    "CredentialRibbon": { "cardMode": "column" },
    "MetaList": { "cardMode": "column" },
    "Emblem": { "cardMode": "column" },
    "Spark": { "cardMode": "column" },
    "PackageCard": { "cardMode": "column", "viewport": "1280x900" },
    "PackageGrid": { "cardMode": "column", "viewport": "1280x900" },
    "Testimonial": { "cardMode": "column", "viewport": "1280x900" },
    "Section": { "cardMode": "column" },
    "PhotoFrame": { "cardMode": "column" }
  }
}
