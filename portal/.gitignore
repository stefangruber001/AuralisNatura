# runtime data — NEVER commit (contains logins / encrypted health data)
config/clients.json
config/social.json
auralis.db
auralis.db-wal
auralis.db-shm
*.sqlite
*.key
.dev_data.key
.env
# No trailing slash: on the server these are SYMLINKS into /var/lib/auralis, and a
# trailing-slash pattern only matches real directories — the symlink would show up
# untracked and a `git clean -fd` would delete it, orphaning every past report.
output_docs
backups
# python
__pycache__/
*.pyc
.ci/__pycache__/
config/plan.json
.logs/
