# Copy to .env and fill in. NEVER commit .env. The launcher sources this file.
AURALIS_API_KEY=change-me-to-a-long-random-string          # staff console key
AURALIS_SECRET=change-me-to-another-long-random-string     # signs client tokens
AURALIS_DATA_KEY=                                          # Fernet key for the encrypted backbone (generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
AURALIS_SMTP_PASSWORD=                                     # Gmail App Password for team@auralisnatura.com
AURALIS_EMAIL_MODE=draft                                   # draft | send | off
AURALIS_AGENT_PROVIDER=claude_cli                          # claude_cli (Pro subscription) | stub
AURALIS_PUBLIC_BASE_URL=https://api.auralisnatura.com
AURALIS_BOOKING_URL=https://cal.com/auralisnatura/report-review
