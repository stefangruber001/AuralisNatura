# Copy to .env and fill in. NEVER commit .env. Comments must be on their OWN line
# (the launcher sources this file, so a trailing "# comment" would corrupt the value).

# Staff console key (long random string)
AURALIS_API_KEY=change-me-to-a-long-random-string
# Signs client portal tokens (another long random string)
AURALIS_SECRET=change-me-to-another-long-random-string
# Fernet key for the encrypted backbone.
# Generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AURALIS_DATA_KEY=
# Gmail App Password for team@auralisnatura.com
AURALIS_SMTP_PASSWORD=
# draft | send | off
AURALIS_EMAIL_MODE=draft
# claude_cli (runs on the Pro subscription) | stub
AURALIS_AGENT_PROVIDER=claude_cli
# production enables fail-closed secret checks
AURALIS_ENV=production
AURALIS_PUBLIC_BASE_URL=https://api.auralisnatura.com
# Review-call booking link used in report emails — your own branded /book page
AURALIS_BOOKING_URL=https://api.auralisnatura.com/book
# Encrypted backups are written here (keep OUTSIDE the git repo)
AURALIS_BACKUP_DIR=
