# Auralis Natura — iOS delivery. Runs entirely on GitHub's macOS runners.
# Auth is a single App Store Connect API key (.p8, base64 in a secret); no Apple
# ID/password anywhere. Signing is handled by `match` (certs/profiles encrypted in
# the match-storage branch). Nothing here needs a local Mac.

default_platform(:ios)

APP_ID  = "com.auralisnatura.book"
XCPROJ  = "AuralisNatura.xcodeproj"
SCHEME  = "AuralisNatura"
PROFILE = "match AppStore #{APP_ID}"   # the profile name match creates
INTERNAL_GROUP = "Founders"            # internal TestFlight group (auto access to all builds)

require "base64"
require "openssl"

# Normalize the App Store Connect key from the ASC_KEY_P8_BASE64 GitHub Actions secret
# into proper PEM text, no matter how it was pasted. Handles three forms:
#   1. full PEM ("-----BEGIN PRIVATE KEY----- ... -----END ... -----")
#   2. base64 of the full PEM (e.g. `base64 -i AuthKey.p8`)
#   3. the bare base64 key body (the lines between BEGIN/END, no header)
# The key is NEVER committed to the repo; it lives only in the encrypted secret.
def asc_key_content
  raw = ENV["ASC_KEY_P8_BASE64"].to_s.strip
  if raw.empty?
    UI.user_error!("ASC_KEY_P8_BASE64 secret is not set. Add it in GitHub → Settings → " \
                   "Secrets and variables → Actions (the App Store Connect .p8 contents).")
  end
  return raw if raw.include?("BEGIN")            # (1) already PEM
  decoded = Base64.decode64(raw)
  return decoded if decoded.include?("BEGIN")     # (2) base64 of a PEM
  # (3) bare base64 body → rebuild a valid PEM
  body = raw.gsub(/\s+/, "").scan(/.{1,64}/).join("\n")
  "-----BEGIN PRIVATE KEY-----\n#{body}\n-----END PRIVATE KEY-----\n"
end

# Safe, non-secret diagnostics: which key/issuer we're using and how the secret was
# encoded. NEVER logs the key material itself.
def log_asc_diagnostics
  raw = ENV["ASC_KEY_P8_BASE64"].to_s.strip
  form = if raw.empty? then "MISSING"
         elsif raw.include?("BEGIN") then "pem"
         elsif Base64.decode64(raw).include?("BEGIN") then "base64-of-pem"
         else "bare-base64-body"
         end
  UI.message("ASC key diagnostics — key_id=#{ENV['ASC_KEY_ID']} issuer=#{ENV['ASC_ISSUER_ID']} secret_form=#{form} secret_len=#{raw.length}")
  begin
    pem = asc_key_content
    ec = OpenSSL::PKey.read(pem)
    UI.message("ASC key parsed OK as #{ec.class} (#{ec.respond_to?(:group) ? ec.group.curve_name : 'n/a'})")
  rescue => e
    UI.error("ASC key failed to parse: #{e.class}: #{e.message}")
  end
end

def asc_key
  pem = asc_key_content
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: pem,
    is_key_content_base64: false,
    in_house: false
  )
end

# Set the global Spaceship ConnectAPI token from the key (for direct spaceship calls).
def connect_token!
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key: asc_key_content
  )
end

# Ensure an INTERNAL TestFlight group exists with access to ALL builds, and add every
# team member (App Store Connect user — always includes the founder) as an internal
# tester. "Access to all builds" means every future build auto-distributes to them, so
# nothing manual is needed per build. Best-effort + verbose; safe to call repeatedly.
def ensure_internal_testing
  connect_token!
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  unless app
    UI.important("No app record for #{APP_ID}; skipping internal-testing setup.")
    return
  end

  group = app.get_beta_groups.find { |g| g.name == INTERNAL_GROUP }
  if group
    UI.success("Internal group '#{INTERNAL_GROUP}' already exists (#{group.id}).")
  else
    # Internal groups reject public-link attributes, so pass them as nil (omitted).
    group = app.create_beta_group(
      group_name: INTERNAL_GROUP,
      is_internal_group: true,
      has_access_to_all_builds: true,
      public_link_enabled: nil,
      public_link_limit: nil,
      public_link_limit_enabled: nil
    )
    UI.success("Created internal group '#{INTERNAL_GROUP}' (#{group.id}).")
  end

  # App Store Connect users hold their Apple ID in `username` (the `email` attr is nil).
  # Add every team member as an internal tester — always includes the founder + Desiree.
  testers = Spaceship::ConnectAPI::User.all.map do |u|
    { email: u.username.to_s, first_name: (u.first_name || "Team"), last_name: (u.last_name || "Member") }
  end.select { |t| t[:email].include?("@") }

  UI.message("Adding internal testers: #{testers.map { |t| t[:email] }.join(', ')}")
  UI.message("ConnectAPI beta_tester methods: #{Spaceship::ConnectAPI.methods.grep(/beta_tester/i).sort.inspect}")
  UI.message("BetaTester class methods: #{Spaceship::ConnectAPI::BetaTester.methods(false).sort.inspect}")
  testers.each do |t|
    begin
      Spaceship::ConnectAPI::BetaTester.create_beta_tester(
        beta_group_id: group.id, email: t[:email], first_name: t[:first_name], last_name: t[:last_name]
      )
      UI.success("Added #{t[:email]}")
    rescue => e
      UI.message("create_beta_tester #{t[:email]}: #{e.message}")
    end
  end
end

platform :ios do
  # Register the Bundle ID (App ID) in the Developer Portal so `match` can create a
  # provisioning profile for it. Uses the App Store Connect API key directly via
  # spaceship (produce is NOT used — it requires an Apple ID username, which we don't
  # have on CI). The App Store Connect *app record* already exists, so only the
  # Bundle ID is needed. Idempotent: no-op if the identifier is already registered.
  desc "Register the Bundle ID on the Developer Portal"
  lane :create_app do
    require "spaceship"
    log_asc_diagnostics
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: asc_key_content
    )
    # 1. Bundle ID (Developer Portal) — needed by match for the provisioning profile.
    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
    if bundle
      UI.success("Bundle ID #{APP_ID} already registered.")
    else
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "Auralis Natura", identifier: APP_ID, platform: "IOS")
      UI.success("Registered Bundle ID #{APP_ID} on the Developer Portal.")
    end

    # 2. App Store Connect app record — needed by upload_to_testflight. Apple's API
    #    cannot CREATE apps (only the web UI / an Apple ID can), so we verify and, if
    #    missing, print every app this key CAN see to pinpoint a bundle-id/team mismatch.
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    if app
      UI.success("App Store Connect record exists: #{app.name} — #{app.bundle_id} (#{app.id}).")
    else
      begin
        visible = Spaceship::ConnectAPI::App.all.map { |a| "#{a.name} <#{a.bundle_id}>" }
        UI.important("Apps visible to key #{ENV['ASC_KEY_ID']}: #{visible.empty? ? '(none)' : visible.join(' | ')}")
      rescue => e
        UI.error("Could not list apps: #{e.message}")
      end
      UI.user_error!("No App Store Connect app record for #{APP_ID}. Apple's API can't create " \
        "apps — create it once in the browser: App Store Connect → Apps → (+) → New App → iOS, " \
        "Bundle ID #{APP_ID}, Name 'Auralis Natura', SKU auralis-app, then re-run.")
    end
  end

  # Set up internal TestFlight distribution: an internal group with access to all
  # builds, plus every team member (incl. the founder) added as an internal tester.
  # Run once per app; after that every `beta` build reaches them automatically.
  desc "Set up internal TestFlight testers (founder always included)"
  lane :internal_testers do
    ensure_internal_testing
  end

  # Push the trilingual store texts (de/en/es) from fastlane/metadata to App Store
  # Connect. Metadata only — no binary, no auto-submit (flip submit_for_review later).
  desc "Upload store metadata (texts)"
  lane :release do
    deliver(
      api_key: asc_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: false,
      precheck_include_in_app_purchases: false
    )
  end

  # One-time (or when certs change): create/refresh the distribution certificate
  # and App Store provisioning profile, storing them encrypted in match-storage.
  desc "Create/refresh signing (writable)"
  lane :signing do
    match(type: "appstore", app_identifier: APP_ID, api_key: asc_key, readonly: false)
  end

  # The main lane: sign, build, upload to TestFlight. Build number auto-derives
  # from the latest TestFlight build so it always increments.
  desc "Build & upload to TestFlight"
  lane :beta do
    setup_ci   # ephemeral keychain on CI; no-op locally
    key = asc_key

    # first run creates the cert+profile; later runs reuse them
    match(type: "appstore", app_identifier: APP_ID, api_key: key, readonly: false)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCPROJ,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE
    )

    build = ((latest_testflight_build_number(
      api_key: key, app_identifier: APP_ID, initial_build_number: 0
    ) rescue 0)) + 1
    UI.message("Using build number #{build}")

    build_app(
      project: XCPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "AuralisNatura.ipa",
      clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build} -allowProvisioningUpdates",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => PROFILE }
      }
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    # Ensure the founder (and every team member) gets this and all future builds via
    # an internal group with access-to-all-builds. Best-effort: never fail the build
    # over distribution (the binary is already uploaded).
    begin
      ensure_internal_testing
    rescue => e
      UI.important("Internal-testing setup skipped: #{e.message}")
    end
  end
end
