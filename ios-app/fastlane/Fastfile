# Auralis Natura — iOS delivery. Runs entirely on GitHub's macOS runners.
# Auth is a single App Store Connect API key (.p8, base64 in a secret); no Apple
# ID/password anywhere. Signing is handled by `match` (certs/profiles encrypted in
# the match-storage branch). Nothing here needs a local Mac.

default_platform(:ios)

APP_ID  = "com.auralisnatura.app"
XCPROJ  = "AuralisNatura.xcodeproj"
SCHEME  = "AuralisNatura"
PROFILE = "match AppStore #{APP_ID}"   # the profile name match creates

require "base64"

# Raw App Store Connect key text (PEM). Source, in order of preference:
#   1. the ASC_KEY_P8_BASE64 secret (raw .p8 text OR base64 one-liner), if set
#   2. the committed key file in AppProducer/ (private repo; no secret needed)
def asc_key_content
  raw = ENV["ASC_KEY_P8_BASE64"].to_s
  if raw.strip.empty?
    # Anchor to the Fastfile's own dir (ios-app/fastlane) so CWD doesn't matter:
    # ../../AppProducer resolves to the repo-root AppProducer/ folder.
    path = [
      File.expand_path("../../AppProducer/AuthKey_5695PLUZS2.p8", __dir__),
      File.expand_path("../AppProducer/AuthKey_5695PLUZS2.p8", __dir__),
      "AppProducer/AuthKey_5695PLUZS2.p8"
    ].find { |p| File.exist?(p) }
    UI.user_error!("No App Store Connect key: set the ASC_KEY_P8_BASE64 secret or add AppProducer/AuthKey_5695PLUZS2.p8") unless path
    raw = File.read(path)
  end
  # Return the PEM text regardless of whether the source was raw or base64-encoded.
  raw.include?("BEGIN") ? raw : Base64.decode64(raw)
end

def asc_key
  pem = asc_key_content
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: pem,
    is_key_content_base64: false,
    in_house: false
  )
end

platform :ios do
  # Register the Bundle ID (App ID) in the Developer Portal so `match` can create a
  # provisioning profile for it. Uses the App Store Connect API key directly via
  # spaceship (produce is NOT used — it requires an Apple ID username, which we don't
  # have on CI). The App Store Connect *app record* already exists, so only the
  # Bundle ID is needed. Idempotent: no-op if the identifier is already registered.
  desc "Register the Bundle ID on the Developer Portal"
  lane :create_app do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: asc_key_content
    )
    existing = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
    if existing
      UI.success("Bundle ID #{APP_ID} already registered — nothing to do.")
    else
      Spaceship::ConnectAPI::BundleId.create(name: "Auralis Natura", identifier: APP_ID)
      UI.success("Registered Bundle ID #{APP_ID} on the Developer Portal.")
    end
  end

  # Push the trilingual store texts (de/en/es) from fastlane/metadata to App Store
  # Connect. Metadata only — no binary, no auto-submit (flip submit_for_review later).
  desc "Upload store metadata (texts)"
  lane :release do
    deliver(
      api_key: asc_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: false,
      precheck_include_in_app_purchases: false
    )
  end

  # One-time (or when certs change): create/refresh the distribution certificate
  # and App Store provisioning profile, storing them encrypted in match-storage.
  desc "Create/refresh signing (writable)"
  lane :signing do
    match(type: "appstore", app_identifier: APP_ID, api_key: asc_key, readonly: false)
  end

  # The main lane: sign, build, upload to TestFlight. Build number auto-derives
  # from the latest TestFlight build so it always increments.
  desc "Build & upload to TestFlight"
  lane :beta do
    setup_ci   # ephemeral keychain on CI; no-op locally
    key = asc_key

    # first run creates the cert+profile; later runs reuse them
    match(type: "appstore", app_identifier: APP_ID, api_key: key, readonly: false)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCPROJ,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE
    )

    build = ((latest_testflight_build_number(
      api_key: key, app_identifier: APP_ID, initial_build_number: 0
    ) rescue 0)) + 1
    UI.message("Using build number #{build}")

    build_app(
      project: XCPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "AuralisNatura.ipa",
      clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build} -allowProvisioningUpdates",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => PROFILE }
      }
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
